{
  "version": "2.0.0",
  "options": {
    "shell": {
      "executable": "powershell.exe",
      "args": ["-NoProfile", "-Command"]
    }
  },
  "tasks": [
    {
      "label": "Build",
      "type": "shell",
      "command": "C:\\lazarus\\lazbuild.exe",
      "args": ["hellocontacts.lpi"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": {
        "owner": "fpc",
        "fileLocation": ["absolute"],
        "pattern": {
          "regexp": "^(.+)\\((\\d+),(\\d+)\\)\\s+(Error|Fatal|Warning|Hint|Note):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "Remove-Item -Recurse -Force -ErrorAction SilentlyContinue lib\\x86_64-win64\\*, hellocontacts.exe",
      "problemMatcher": []
    },
    {
      "label": "Clean and Build",
      "type": "shell",
      "command": "C:\\lazarus\\lazbuild.exe",
      "args": ["-B", "hellocontacts.lpi"],
      "group": "build",
      "problemMatcher": {
        "owner": "fpc",
        "fileLocation": ["absolute"],
        "pattern": {
          "regexp": "^(.+)\\((\\d+),(\\d+)\\)\\s+(Error|Fatal|Warning|Hint|Note):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    },
    {
      "label": "Clean, Build and Run",
      "type": "shell",
      "command": ".\\hellocontacts.exe",
      "dependsOn": ["Clean and Build"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Test",
      "type": "shell",
      "command": "C:\\lazarus\\lazbuild.exe tests\\hellocontacts_tests.lpi; if ($?) { .\\tests\\hellocontacts_tests.exe --all --format=plain }",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Run",
      "type": "shell",
      "command": ".\\hellocontacts.exe",
      "problemMatcher": []
    }
  ]
}
